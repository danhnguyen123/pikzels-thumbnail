# Override cho production — có trong repo, KHÔNG chứa secret.
# Được nạp SAU .env nên ghi đè các key trùng.

# Container nghe mọi interface (bắt buộc để vào được qua public IP).
APP_HOST=0.0.0.0
APP_PORT=8000

# Đường dẫn ghi trong container (đã map ra Oracle Volume qua docker-compose volumes).
DATA_DIR=/app/data
OUTPUT_DIR=/app/output
