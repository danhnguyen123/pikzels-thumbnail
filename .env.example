# === SECRET của bạn — copy thành .env, scp lên server, KHÔNG commit ===

# API key Pikzels (bắt buộc). Lấy ở app.pikzels.com/platform
PIKZELS_API_KEY=

# Basic Auth — BẮT BUỘC khi mở public IP:port.
# Bỏ trống = KHÔNG xác thực (chỉ dùng local). Đặt mật khẩu mạnh, ngẫu nhiên.
APP_BASIC_AUTH_USER=admin
APP_BASIC_AUTH_PASS=

# Cổng public (host). Container luôn nghe 8000; đây là cổng mở ra ngoài.
# Đổi sang cổng lạ (vd 8137) để giảm quét tự động nếu muốn.
PUBLISH_PORT=8000
